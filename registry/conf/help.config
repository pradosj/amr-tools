// Help message of the pipelines (nf-schema, from nextflow_schema.json): --help, --help <param>, --helpFull, --showHidden
validation {
    help {
        enabled = true
    }
}

// the help params, declared so that Nextflow accepts them on the command line
params {
    help       = false
    helpFull   = false
    showHidden = false
}
