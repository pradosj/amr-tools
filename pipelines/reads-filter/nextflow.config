
manifest {
    name            = 'reads-filter'
    contributors    = [
        [
            name: 'Julien Prados',
            affiliation: 'University of Geneva',
            email: 'julien.prados@unige.ch',
            contribution: ['author', 'maintainer'],
            orcid: '0000-0002-8546-241X'
        ]
    ]
    homePage        = 'https://github.com/BioinfoSupport/amr-tools/pipelines/reads-filter'
    description     = 'Filter ONT reads by quality and length (chopper) and subsample ONT and Illumina reads to a maximum number of bases'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.10.4'
    version         = 'v0.01'
    doi             = ''
}

// ---------------------------------------
//  Setup
// ---------------------------------------

nextflow.enable.dsl = 2
nextflow.enable.moduleBinaries = true
workflow.output.mode = 'link'
resume = true

plugins {
  id 'nf-schema@2.7.3'
}



process.shell = ["bash","-C","-e","-u","-o","pipefail"]

// ---------------------------------------
//  Define profiles
// ---------------------------------------

includeConfig "conf/containers.config"
includeConfig "conf/profiles.config"






