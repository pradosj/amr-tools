
manifest {
    name            = 'asm-compare'
    contributors    = [
        [
            name: 'Julien Prados',
            affiliation: 'University of Geneva',
            email: 'julien.prados@unige.ch',
            contribution: ['author', 'maintainer'],
            orcid: '0000-0002-8546-241X'
        ]
    ]
    homePage        = 'https://github.com/BioinfoSupport/amr-tools/wf/asm-compare'
    description     = 'Compare 2 assembled genomes'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.10.4'
    version         = 'v0.01'
    doi             = ''
}

// ---------------------------------------
//  Setup
// ---------------------------------------

nextflow.enable.dsl = 2
nextflow.enable.moduleBinaries = true
workflow.output.mode = 'link'
resume = true

plugins {
  id 'nf-schema@2.7.3'
}



process.shell = ["bash","-C","-e","-u","-o","pipefail"]



// ---------------------------------------
//  Define profiles
// ---------------------------------------

includeConfig "conf/containers.config"
includeConfig "conf/profiles.config"

// Pipeline specific additions to the shared profiles
profiles {
  test {
    params.ref   = "${projectDir}/assets/tests/CP047704.1.fasta"
    params.query = "${projectDir}/assets/tests/*.fasta"
  }

}





