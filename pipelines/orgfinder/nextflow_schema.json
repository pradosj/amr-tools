{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
	"properties": {

		"query": {
			"type": "string",
			"format": "file-path-pattern",
			"exists": true,
			"pattern": "^\\S+\\.(fasta|fa|fna)$",
			"description": "Path to FASTA file containing query genomes"
		},
		
		"ref": {
			"title": "Reference genome database",
			"type": "object",
			"properties": {
				"fasta": {
					"type": "string",
					"format": "file-path-pattern",
					"exists": true,
					"pattern": "^\\S+\\.(fasta|fa|fna)$",			
					"description": "Path to FASTA files containing reference genomes",
					"default": null
				},
				"db": {
					"type": "string",
					"format": "dir-path",
					"exists": true,
					"description": "Path to a directory with reference genome database",
					"default": null
				}				
			}
		}
		
	},
	
	"oneOf": [
		{"properties": {"ref": {"not": {"required": ["fasta","db"]}}}}
  ]

}