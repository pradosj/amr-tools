
manifest {
    name            = 'plasmid-lineage'
    contributors    = [
        [
            name: 'Julien Prados',
            affiliation: 'University of Geneva',
            email: 'julien.prados@unige.ch',
            contribution: ['author', 'maintainer'],
            orcid: '0000-0002-8546-241X'
        ]
    ]
    homePage        = 'https://github.com/pradosj/amr-tools/wf/plasmid-lineage'
    description     = 'Lineage of a set of plasmids: rotation, alignment and annotation'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.10.4'
    version         = 'v0.01'
    doi             = ''
}

// ---------------------------------------
//  Setup
// ---------------------------------------

nextflow.enable.dsl = 2
nextflow.enable.moduleBinaries = true
workflow.output.mode = 'link'
resume = true

plugins {
  id 'nf-schema@2.7.3'
}



process.shell = ["bash","-C","-e","-u","-o","pipefail"]

// ---------------------------------------
//  Define profiles
// ---------------------------------------

includeConfig "conf/containers.config"
includeConfig "conf/profiles.config"







// Pipeline specific profiles
profiles {
  test {
    params.fasta = "https://www.ebi.ac.uk/ena/browser/api/fasta/CP047704.1,https://www.ebi.ac.uk/ena/browser/api/fasta/CP083077,https://www.ebi.ac.uk/ena/browser/api/fasta/KM406488.1,https://www.ebi.ac.uk/ena/browser/api/fasta/JQ837276.1"
  }
}
