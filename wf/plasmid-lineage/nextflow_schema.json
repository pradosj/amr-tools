{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"required": ["fasta"],
	"properties": {
		"db": {
			"title": "Databases",
			"type": "object",
			"description": "Databases folder of the pipelines: a database missing from it is built (and saved to <output dir>/db). The folder can also be given as a tar archive of it (path or URL), that must hold all the needed databases.",
			"properties": {
				"basedir": {
					"type": "string",
					"default": "results/db",
					"description": "Databases folder, as built by wf/db or the db/ folder of a previous run, or tar archive of it (path or URL)"
				},
				"amrfinderplus": {
					"type": "string",
					"default": "amrfinderplus",
					"description": "AMRFinderPlus database, relative to basedir"
				}
			}
		},
		"fasta": {
			"type": "string",
			"pattern": "^(((https?|ftp)://[^,\\s]+|\\S+(\\.(fasta|fa|fna)(\\.gz)?|\\})!?)(,\\s*|$))+$",
			"description": "FASTA files of the plasmids to compare (optionally gzipped): comma-separated paths, glob patterns or URLs (one plasmid per file, named by its file name; all the plasmids form one set; sequence ids must be unique)"
		},
		"name": {
			"type": "string",
			"default": "plasmids",
			"description": "Name of the set of plasmids, used as output folder"
		},
		"no_rotation": {
			"type": "boolean",
			"default": false,
			"description": "Do not rotate the plasmids: the analysis runs on the given sequences"
		},
		"lineage": {
			"title": "Options of the plasmid lineage analysis",
			"type": "object",
			"properties": {
				"core_genome_count": {
					"type": "integer",
					"minimum": 1,
					"description": "Minimum number of plasmids sharing a core genome region (required)"
				},
				"blastn_args": {
					"type": "string",
					"default": "-perc_identity 70 -evalue 1e-3 -subject_besthit",
					"description": "Options of BLASTN for the alignment of the plasmids"
				}
			}
		},
		"amr": {
			"title": "Parameters for tool amr annotation",
			"type": "object",
			"properties": {
					"speciator": {
					  "type": "object",
						"properties": {
							"skip": {
							  "type": "boolean",
							  "default": true
							},
							"args": {
							  "type": "string",
							  "default": ""
							}
						}
					},
					"amrfinderplus": {
					  "type": "object",
						"properties": {
							"skip": {
							  "type": "boolean",
							  "default": false
							},
							"args": {
							  "type": "string",
							  "default": ""
							}
						}
					},
					"mobtyper": {
					  "type": "object",
						"properties": {
							"skip": {
							  "type": "boolean",
							  "default": false
							},
							"args": {
							  "type": "string",
							  "default": ""
							}
						}
					},
					"plasmidfinder": {
					  "type": "object",
						"properties": {
							"skip": {
							  "type": "boolean",
							  "default": false
							},
							"skip_shortread": {
							  "type": "boolean",
							  "default": true
							},
							"skip_longread": {
							  "type": "boolean",
							  "default": true
							},
							"args": {
							  "type": "string",
							  "default": ""
							}
						}
					},
					"resfinder": {
					  "type": "object",
						"properties": {
							"skip": {
							  "type": "boolean",
							  "default": false
							},
							"skip_shortread": {
							  "type": "boolean",
							  "default": true
							},
							"skip_longread": {
							  "type": "boolean",
							  "default": true
							},
							"args": {
							  "type": "string",
							  "default": ""
							}
						}
					},
					"MLST": {
					  "type": "object",
						"properties": {
							"skip": {
							  "type": "boolean",
							  "default": true
							},
							"args": {
							  "type": "string",
							  "default": ""
							}
						}
					},
					"prokka": {
					  "type": "object",
						"properties": {
							"skip": {
							  "type": "boolean",
							  "default": true
							},
							"args": {
							  "type": "string",
							  "default": ""
							}
						}
					}
			}
		}
	}
}
