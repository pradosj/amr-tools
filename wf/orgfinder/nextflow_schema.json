{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
	"properties": {

		"query": {
			"type": "string",
			"pattern": "^(((https?|ftp)://[^,\\s]+|\\S+(\\.(fasta|fa|fna)|\\}))(,\\s*|$))+$",
			"description": "FASTA files of the query genomes: comma-separated paths, glob patterns or URLs"
		},
		
		"ref": {
			"title": "Reference genome database",
			"type": "object",
			"properties": {
				"fasta": {
					"type": "string",
					"pattern": "^(((https?|ftp)://[^,\\s]+|\\S+(\\.(fasta|fa|fna)|\\}))(,\\s*|$))+$",
					"description": "FASTA files of the reference genomes: comma-separated paths, glob patterns or URLs",
					"default": null
				},
				"db": {
					"type": "string",
					"format": "directory-path",
					"exists": true,
					"description": "Path to a directory with reference genome database",
					"default": null
				}				
			}
		},

		"fastani_args": {
			"type": "string",
			"description": "Extra arguments given to fastANI"
		}
		
	},
	
	"oneOf": [
		{"properties": {"ref": {"not": {"required": ["fasta","db"]}}}}
  ]

}