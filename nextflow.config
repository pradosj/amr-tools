// ---------------------------------------
//  Setup
// ---------------------------------------

nextflow.enable.dsl = 2
nextflow.enable.moduleBinaries = true
workflow.output.mode = 'link'
resume = true

plugins {
  id 'nf-schema@2.7.3'
}





// ---------------------------------------
//  Manifest
// ---------------------------------------

manifest {
    name            = 'amr-tools'
    contributors    = [
        [
            name: 'Julien Prados',
            affiliation: 'University of Geneva',
            email: 'julien.prados@unige.ch',
            contribution: ['author', 'maintainer'],
            orcid: '0000-0002-8546-241X'
        ],
        [
            name: 'Roberto Sierra',
            affiliation: 'University Hosital Geneva',
            email: 'roberto.prados@unige.ch',
            orcid: '0000-0002-8657-1781'
        ],
        [
            name: 'Diego Andrey',
            affiliation: 'University Hosital Geneva',
            email: 'diego.andrey@unige.ch',
            orcid: '0000-0003-3247-9274'
        ]
    ]
    homePage        = 'https://github.com/pradosj/amr-tools'
    description     = 'Antimicrobial Resistance Pipeline'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.10.4'
    version         = 'v0.80'
    doi             = ''
}

// Params and their default values are declared in the params block of main.nf.
// Nested params can be partially overridden (e.g. --amr.prokka.skip false):
// the fields that are not given fall back to the defaults of the subworkflows and modules.


// ---------------------------------------
//  Configure processes
// ---------------------------------------

process.shell = ["bash","-C","-e","-u","-o","pipefail"]



// ---------------------------------------
//  Define profiles
// ---------------------------------------

includeConfig "conf/containers.config"
includeConfig "conf/profiles.config"

// Pipeline specific additions to the shared profiles
profiles {
  test {
    params.assemblies.fasta = "https://www.ebi.ac.uk/ena/browser/api/fasta/CP047704.1,https://www.ebi.ac.uk/ena/browser/api/fasta/CP083077,https://www.ebi.ac.uk/ena/browser/api/fasta/KM406488.1,https://www.ebi.ac.uk/ena/browser/api/fasta/JQ837276.1"    // plasmids from ENA: Klebsiella pneumoniae (CP047704.1, CP083077), Salmonella enterica (KM406488.1), Enterobacter cloacae (JQ837276.1)
    params.reads.ont = "ftp://ftp.sra.ebi.ac.uk/vol1/fastq/ERR147/086/ERR14747186/ERR14747186.fastq.gz"    // Klebsiella pneumoniae, ONT (ENA ERR14747186)
  }
}



