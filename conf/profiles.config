// ---------------------------------------
//  Profiles shared by all the pipelines of the repository
//  (included by each nextflow.config, which can extend these profiles and adds its own `test` profile)
// ---------------------------------------

profiles {
  // default profile when no -profile is given: same as `docker` (keep both in sync)
  standard {
    docker {
      enabled = true
      runOptions = "--user \$(id -u):\$(id -g) --group-add 100 --platform linux/amd64"
    }
  }

  docker {
    docker {
      enabled = true
      runOptions = "--user \$(id -u):\$(id -g) --group-add 100 --platform linux/amd64"
    }
  }

  // arm64 images for the processes whose default image is amd64 only
  arm64 {
    process {
      withLabel: 'medaka' {
        container = 'docker.io/ontresearch/medaka:shac4e11bfa4e65668b28739ba32edc3af12baf7574-arm64'
        containerOptions = '--platform linux/arm64'
      }
    }
  }

  hpc {
    env {
      NXF_TEMP = "${System.getenv('HOME')}/scratch/tmp"
    }
    apptainer {
      enabled = true
      runOptions = "-B/scratch -B/srv/beegfs/scratch/users -B${System.getenv('HOME')}"
      autoMounts = true
      cacheDir = "${System.getenv('HOME')}/scratch/singularity"
      pullTimeout = '4h'
    }
    process {
      executor = "slurm"
      queue = 'shared-cpu'
      resourceLimits = [ cpus: 32, memory: 64.GB, time: 11.h ]
    }
    process {
      withLabel: 'local' {   // light tasks (e.g. file copies) not worth a slurm job
        executor = "local"
      }
    }
  }

  tiny {
    process {
      resourceLimits = [ cpus: 8, memory: 14.GB, time: 3.h ]
    }
  }
}
